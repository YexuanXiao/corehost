#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,1
PRODUCTVERSION 0,0,0,1
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "A reimplementation of Windows conhost"
            VALUE "FileVersion", "0.0.0.1-beta"
            VALUE "InternalName", "corehost"
            VALUE "OriginalFilename", "corehost.exe"
            VALUE "ProductName", "CoreHost"
            VALUE "ProductVersion", "0.0.0.1-beta"
            VALUE "LegalCopyright", "Copyright (c) 2026 YexuanXiao. All rights reserved.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
