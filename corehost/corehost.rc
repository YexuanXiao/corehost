#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION COREHOST_VERSION_MAJOR,COREHOST_VERSION_MINOR,COREHOST_VERSION_PATCH,COREHOST_VERSION_BUILD
PRODUCTVERSION COREHOST_VERSION_MAJOR,COREHOST_VERSION_MINOR,COREHOST_VERSION_PATCH,COREHOST_VERSION_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "FileDescription", "corehost (Core Console Host)"
            VALUE "FileVersion", COREHOST_VERSION
            VALUE "InternalName", "corehost"
            VALUE "OriginalFilename", "corehost.exe"
            VALUE "ProductName", "CoreHost"
            VALUE "ProductVersion", COREHOST_VERSION
            VALUE "LegalCopyright", "Copyright (c) 2026 YexuanXiao. All rights reserved.\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 1200
    END
END
